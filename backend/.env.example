# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_long_random_value

# Database (PostgreSQL recommended; SQLite works for local/dev/testing)
# Examples:
#   postgresql+psycopg2://svc_app_user:your_db_password@localhost:5432/servicecomplaint
#   sqlite:///dev.db
DATABASE_URL=sqlite:///dev.db

# Email (OTP verification, password reset) - all credentials come from
# here, never hard-coded in source. Without MAIL_SERVER set, OTP/reset
# codes are logged server-side instead of emailed, so local development
# works without a real mail account. Set these for real email delivery,
# e.g. using a Gmail App Password or any SMTP provider (SendGrid, Mailgun,
# Postmark, etc.):
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Google Sign-In (OAuth 2.0). Both must be set for the "Continue with
# Google" button to appear on the frontend - it stays hidden otherwise.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application") and add GOOGLE_REDIRECT_URI
# to its Authorized redirect URIs list exactly as written here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Where the backend sends the browser after a Google login completes.
FRONTEND_URL=http://localhost:5173

# CORS - comma separated list of trusted frontend origins
CORS_ORIGINS=http://localhost:5173

# Session / cookie security
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=60

# File uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=15

# Rate limiting storage (memory:// for dev, redis:// for production)
RATELIMIT_STORAGE_URI=memory://

# SLA defaults (used only if a category/priority has no explicit sla_rules row)
DEFAULT_RESPONSE_HOURS=24
DEFAULT_RESOLUTION_HOURS=72

# Reference number prefix
REQUEST_REF_PREFIX=SR

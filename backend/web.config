<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>

        <handlers>
            <add name="httpPlatformHandler"
                 path="*"
                 verb="*"
                 modules="HttpPlatformHandlerModule"
                 resourceType="Unspecified" />
        </handlers>

        <httpPlatform
            processPath=".venv\Scripts\python.exe"
            arguments="run.py --port=%HTTP_PLATFORM_PORT%"
            stdoutLogEnabled="true"
            stdoutLogFile=".\flask">

            <environmentVariables>
                <environmentVariable
                    name="FLASK_ENV"
                    value="production" />
            </environmentVariables>

        </httpPlatform>

    </system.webServer>
</configuration>
